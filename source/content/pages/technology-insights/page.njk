<span class="tech-v1">Learning</span><span class="tech-v2">Work</span><span class="tech-v3">Business</span><span class="tech-v4">Daily Life</span>
<div class="tech-feature-core"><svg viewbox="0 0 100 100"><rect height="46" rx="6" width="64" x="18" y="20"></rect><path d="M10 76h80M40 66l-4 10M60 66l4 10"></path><path d="M31 45h10l6-10 8 20 6-10h9"></path></svg></div>
</div>
</div>
