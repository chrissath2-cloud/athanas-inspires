{% block content %}
<section class="calculator-hero">
<div class="calculator-hero-text">
<p class="eyebrow">Athanas Inspires Tools</p>
<h1>Scientific Calculator</h1>
<p>A beautiful calculator for learners, teachers, and everyday problem solvers. Calculate clearly. Learn confidently. Build step by step.</p>
<div class="calculator-hero-actions">
<a class="btn" href="#calculatorApp">Start Calculating</a>
<a class="btn secondary-btn" href="index.html">Back to Tools</a>
</div>
</div>
</section>
<main class="calculator-page" id="main-content">
<section aria-label="Athanas Inspires Scientific Calculator" class="calculator-shell">
<div class="calculator-topbar">
<div>
<p class="calc-mini-title">Athanas Inspires</p>
<h2>Scientific Calculator</h2>
</div>
<button aria-label="Switch between degree and radian mode" class="angle-toggle" id="angleMode" type="button">DEG</button>
</div>
<div aria-live="polite" class="calculator-screen">
<div class="screen-expression" id="expressionDisplay">0</div>
<div class="screen-result" id="resultDisplay">Ready</div>
</div>
<div class="calculator-tools-row">
<button class="pill-tool" id="copyResult" type="button">Copy Result</button>
<button class="pill-tool" id="clearHistory" type="button">Clear History</button>
</div>
<div class="calculator-grid">
<button class="calc-btn danger" data-action="clear">AC</button>
<button class="calc-btn warning" data-action="delete">DEL</button>
<button class="calc-btn operator" data-value="(">(</button>
<button class="calc-btn operator" data-value=")">)</button>
<button class="calc-btn operator" data-value="%">%</button>
<button class="calc-btn scientific" data-func="sin">sin</button>
<button class="calc-btn scientific" data-func="cos">cos</button>
<button class="calc-btn scientific" data-func="tan">tan</button>
<button class="calc-btn scientific" data-func="log">log</button>
<button class="calc-btn scientific" data-func="ln">ln</button>
<button class="calc-btn scientific" data-func="sqrt">√</button>
<button class="calc-btn scientific" data-action="square">x²</button>
<button class="calc-btn scientific" data-value="^">xʸ</button>
<button class="calc-btn scientific" data-action="inverse">1/x</button>
<button class="calc-btn scientific" data-action="factorial">x!</button>
<button class="calc-btn number" data-value="7">7</button>
<button class="calc-btn number" data-value="8">8</button>
<button class="calc-btn number" data-value="9">9</button>
<button class="calc-btn operator" data-value="/">÷</button>
<button class="calc-btn constant" data-label="π" data-value="Math.PI">π</button>
<button class="calc-btn number" data-value="4">4</button>
<button class="calc-btn number" data-value="5">5</button>
<button class="calc-btn number" data-value="6">6</button>
<button class="calc-btn operator" data-value="*">×</button>
<button class="calc-btn constant" data-label="e" data-value="Math.E">e</button>
<button class="calc-btn number" data-value="1">1</button>
<button class="calc-btn number" data-value="2">2</button>
<button class="calc-btn number" data-value="3">3</button>
<button class="calc-btn operator" data-value="-">−</button>
<button class="calc-btn scientific" data-label="EXP" data-value="**">Exp</button>
<button class="calc-btn number wide" data-value="0">0</button>
<button class="calc-btn number" data-value=".">.</button>
<button class="calc-btn operator" data-value="+">+</button>
<button class="calc-btn equals" data-action="calculate">=</button>
</div>
</section>
<aside class="calculator-side-panel">
<div class="side-card">
<h3>Calculation History</h3>
<p>Your recent calculations appear here.</p>
<div class="history-list" id="historyList">
<span class="empty-history">No history yet.</span>
</div>
</div>
<div class="side-card learning-card">
<h3>Quick Tips</h3>
<ul>
<li>Use <strong>DEG</strong> for most school trigonometry questions.</li>
<li>Use brackets when writing longer expressions.</li>
<li>Keyboard supported: numbers, operations, Enter, Backspace, Escape.</li>
</ul>
</div>
</aside>
</main>
{% endblock %}

